# Copy to .env and fill. Never commit .env.
ANTHROPIC_API_KEY=
TTS_PROVIDER=openai            # openai | google | elevenlabs
TTS_API_KEY=
IMAGE_API_KEY=

# YouTube OAuth — see README "Getting the refresh token"
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Safety rails
MONTHLY_COST_CEILING_USD=120
DRY_RUN=true                   # true = never actually uploads
